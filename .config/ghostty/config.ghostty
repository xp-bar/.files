theme               = xp-bar
window-colorspace   = srgb
font-family         = "DroidSansM Nerd Font"
macos-option-as-alt = true
background-opacity  = 0.94
background-blur  = true

window-padding-x = 4
window-padding-y = 4

window-padding-balance = true

# disable ligatures
font-feature = -calt, -liga, -dlig
cursor-style = bar
